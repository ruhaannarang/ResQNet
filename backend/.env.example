# ResQNet Backend Environment Configuration Template
# Copy this file to .env before running the backend:
# cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resqnet
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resqnet

# Routing Providers
# auto = Google if key present else OSRM; explicit: osrm | google | mock
ROUTING_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
MAPBOX_API_KEY=
HERE_API_KEY=
TOMTOM_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=15

# Set to true to enable simulated routes as fallback/demo (never silently in production)
ALLOW_SIMULATED_ROUTES=false

# Weather
WEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo

# Rerouting thresholds (hysteresis)
REROUTE_IMPROVEMENT_THRESHOLD=0.15
REROUTE_DEGRADATION_THRESHOLD=0.12
REROUTE_MIN_INTERVAL_SECONDS=60

# App Settings
DEBUG=true
APP_NAME=ResQNet
APP_VERSION=1.0.0
